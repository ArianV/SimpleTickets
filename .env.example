# Required. Bot token from https://discord.com/developers/applications -> your app -> Bot.
DISCORD_TOKEN=

# Optional. Register slash commands to this server only, so changes show up instantly
# while developing. Leave empty to register them globally.
DEV_GUILD_ID=

# Optional. Where server settings and open tickets are stored.
DATA_FILE=data/tickets.json

# Optional. One of: debug, info, warn, error.
LOG_LEVEL=info

{
  "name": "simpletickets",
  "version": "1.0.0",
  "description": "A self-hosted Discord ticket bot: slash commands, private ticket channels, claiming and HTML transcripts.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "deploy": "tsx src/deploy-commands.ts",
    "deploy:prod": "node dist/deploy-commands.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "tickets",
    "support",
    "typescript"
  ],
  "author": "Arian",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArianV/SimpleTickets.git"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
